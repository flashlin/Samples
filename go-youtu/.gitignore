# macOS / Virtual Disk (vdisk) hidden files
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Miscellaneous hidden & temporary files
*.class
*.log
*.pyc
*.swp
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Local SDK environment generated by setup.sh
.env.sdk
.env*

# IntelliJ / Android Studio / VS Code / Editor hidden folders
*.iml
*.ipr
*.iws
.idea/
.vscode/
.fleet/

# Flutter / Dart / Pub hidden & build artifacts
**/doc/api/
**/ios/Flutter/.last_build_id
**/.last_build_id
.metadata
.packages
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.fvm/
.fvmrc
/build/
/dist/
/coverage/
.widget_preview/

# Compiled binaries
*.apk
*.aab
*.ipa
*.app/
app.*.symbols
app.*.map.json

# Android Gradle, Kotlin & NDK hidden caches
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle/
**/.gradle/
/android/.kotlin/
**/.kotlin/
/android/.cxx/
**/.cxx/
/android/captures/
/android/local.properties
/android/**/GeneratedPluginRegistrant.java
/android/key.properties
*.jks
*.keystore

# iOS CocoaPods, SwiftPM & ephemeral hidden files
/ios/Pods/
/ios/.symlinks/
/ios/Flutter/Flutter.framework
/ios/Flutter/Flutter.podspec
/ios/Flutter/Generated.xcconfig
/ios/Flutter/ephemeral/
/ios/Runner/GeneratedPluginRegistrant.*
**/xcuserdata/

# Ensure Clean Architecture source directories (e.g. lib/**/data) are not masked by parent .gitignore
!lib/**/
!lib/**/data/
!lib/**/data/**
!android/app/src/debug/
!android/app/src/debug/**
!pubspec.lock

